{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"app-practice","text":"<p>Streamlit \u306e\u7df4\u7fd2\u7528\u30de\u30eb\u30c1\u30da\u30fc\u30b8\u30a2\u30d7\u30ea\u3002</p> <p>\u30a2\u30d7\u30ea\u3092\u958b\u304f</p>"},{"location":"#_1","title":"\u904a\u3073\u65b9","text":"<ul> <li> <p> hangman</p> <p>\u4f0f\u305b\u3089\u308c\u305f\u82f1\u5358\u8a9e\u30921\u6587\u5b57\u305a\u3064\u5f53\u3066\u308b\u3002\u30df\u30b9\u306f8\u56de\u307e\u3067\u3002</p> <p> How to play hangman</p> </li> <li> <p> high and low</p> <p>\u5834\u306e\u30ab\u30fc\u30c9\u3068\u6b21\u306e\u30ab\u30fc\u30c9\u306e\u5927\u5c0f\u3092\u4e88\u60f3\u3059\u308b\u3002</p> <p> How to play high and low</p> </li> <li> <p> kanji reversi</p> <p>\u30ea\u30d0\u30fc\u30b7\u3092\u3057\u306a\u304c\u3089\u3001\u76e4\u9762\u306b\u96a0\u308c\u305f\u6f22\u5b57\u3092\u5f53\u3066\u308b\u3002</p> <p> How to play kanji reversi</p> </li> </ul>"},{"location":"about/","title":"Three games are here","text":"<p>Streamlit \u3067\u4f5c\u3063\u305f3\u3064\u306e\u30b2\u30fc\u30e0\u3001hangman\u30fbhigh and low\u30fbkanji reversi \u306e\u904a\u3073\u65b9\u3092\u307e\u3068\u3081\u305f\u30b5\u30a4\u30c8\u3002</p> <p>\u30a2\u30d7\u30ea\u3092\u958b\u304f GitHub</p>"},{"location":"about/#_1","title":"\u4f7f\u3063\u3066\u3044\u308b\u3082\u306e","text":"<ul> <li>\u30a2\u30d7\u30ea: Python / Streamlit</li> <li>\u3053\u306e\u30b5\u30a4\u30c8: MkDocs / Material for MkDocs</li> </ul>"},{"location":"about/#_2","title":"\u7d20\u6750","text":"<ul> <li>hangman \u306e\u5358\u8a9e\u30ea\u30b9\u30c8: \u4f5c\u8005\u304c\u4f5c\u6210</li> <li>\u30ab\u30fc\u30c9\u753b\u50cf: PixAI \u306e Tsubaki.3 \u3067\u751f\u6210\u3057\u3001\u6570\u5b57\u306f\u4f5c\u8005\u304c\u66f8\u304d\u52a0\u3048\u305f</li> <li>\u30b9\u30fc\u30c8\u306e\u30a2\u30a4\u30b3\u30f3: Claude \u304c\u4f5c\u6210</li> </ul>"},{"location":"about/#_3","title":"\u30e9\u30a4\u30bb\u30f3\u30b9","text":"<p>\u5229\u7528\u306e\u7bc4\u56f2</p> <ul> <li>\u30ab\u30fc\u30c9\u753b\u50cf: \u7b2c\u4e09\u8005\u306e\u5229\u7528(\u8ee2\u8f09\u30fb\u518d\u914d\u5e03\u30fb\u5546\u7528\u5229\u7528\u3092\u542b\u3080)\u3092\u8a31\u53ef\u3057\u306a\u3044\u3002</li> <li>\u30b3\u30fc\u30c9\u304a\u3088\u3073\u305d\u306e\u4ed6\u306e\u7d20\u6750(\u30b9\u30fc\u30c8\u306e\u30a2\u30a4\u30b3\u30f3\u306a\u3069): \u500b\u4eba\u5229\u7528\u306e\u307f\u53ef\u3002</li> </ul>"},{"location":"howtous/hang_man/","title":"How to play hangman","text":"<p>\u76ee\u7684</p> <p>\u4f0f\u305b\u3089\u308c\u305f\u82f1\u5358\u8a9e\u3092\u30011\u6587\u5b57\u305a\u3064\u5f53\u3066\u3066\u5b8c\u6210\u3055\u305b\u308b\u3002</p>"},{"location":"howtous/hang_man/#_1","title":"\u904a\u3073\u65b9","text":"<ol> <li>\u753b\u9762\u306b\u3001\u5358\u8a9e\u306e\u6587\u5b57\u6570\u5206\u306e\u4e0b\u7dda(<code>_</code>)\u3068\u7d5e\u9996\u53f0\u306e\u7d75\u304c\u8868\u793a\u3055\u308c\u308b\u3002\u5358\u8a9e\u306f\u5358\u8a9e\u30ea\u30b9\u30c8\u304b\u3089\u30e9\u30f3\u30c0\u30e0\u306b\u9078\u3070\u308c\u308b\u3002</li> <li>A\u301cZ \u306e\u30dc\u30bf\u30f3\u304b\u3089\u3001\u5358\u8a9e\u306b\u542b\u307e\u308c\u308b\u3068\u601d\u3046\u6587\u5b57\u3092\u9078\u3076\u3002</li> <li>\u542b\u307e\u308c\u3066\u3044\u308c\u3070\u3001\u305d\u306e\u6587\u5b57\u304c\u5165\u308b\u4f4d\u7f6e\u3059\u3079\u3066\u306b\u540c\u6642\u306b\u8868\u793a\u3055\u308c\u308b\u3002</li> <li>\u542b\u307e\u308c\u3066\u3044\u306a\u3051\u308c\u3070\u30df\u30b9\u306b\u306a\u308a\u3001\u7d75\u304c1\u6bb5\u968e\u9032\u3080\u3002</li> <li>\u3059\u3079\u3066\u306e\u6587\u5b57\u3092\u5f53\u3066\u308c\u3070\u52dd\u3061\u3002</li> </ol> <p>\u9078\u3093\u3060\u6587\u5b57</p> <p>\u4e00\u5ea6\u9078\u3093\u3060\u6587\u5b57\u306e\u30dc\u30bf\u30f3\u306f \u274c \u8868\u793a\u306b\u306a\u308a\u3001\u62bc\u305b\u306a\u304f\u306a\u308b\u3002</p> <p>\u30df\u30b9\u3068\u30b2\u30fc\u30e0\u30aa\u30fc\u30d0\u30fc</p> <p>\u30df\u30b9\u306f8\u56de\u307e\u3067\u30028\u56de\u76ee\u306e\u30df\u30b9\u3067 <code>GAME OVER</code> \u306b\u306a\u308b\u3002</p>"},{"location":"howtous/hang_man/#_2","title":"\u7d50\u679c\u306e\u8868\u793a","text":"<ul> <li> <p> CLEAR</p> <p>\u3059\u3079\u3066\u306e\u6587\u5b57\u3092\u5f53\u3066\u305f\u3002\u7b54\u3048\u306e\u5358\u8a9e\u3068\u65e5\u672c\u8a9e\u306e\u610f\u5473\u304c\u8868\u793a\u3055\u308c\u308b\u3002</p> </li> <li> <p> GAME OVER</p> <p>8\u56de\u30df\u30b9\u3057\u305f\u3002\u7b54\u3048\u306e\u5358\u8a9e\u3068\u65e5\u672c\u8a9e\u306e\u610f\u5473\u304c\u8868\u793a\u3055\u308c\u308b\u3002</p> </li> </ul> <p>CONTINUE?</p> <p><code>CONTINUE?</code> \u30dc\u30bf\u30f3\u3092\u62bc\u3059\u3068\u3001\u65b0\u3057\u3044\u5358\u8a9e\u3067\u6700\u521d\u304b\u3089\u3084\u308a\u76f4\u305b\u308b\u3002\u30df\u30b9\u306e\u56de\u6570\u3068\u9078\u629e\u6e08\u307f\u306e\u6587\u5b57\u306f\u30ea\u30bb\u30c3\u30c8\u3055\u308c\u308b\u3002</p> <p>\u51fa\u984c\u306b\u3064\u3044\u3066</p> <p>\u5358\u8a9e\u306f\u30e9\u30f3\u30c0\u30e0\u306b\u9078\u3070\u308c\u3001\u51fa\u984c\u6e08\u307f\u306e\u5358\u8a9e\u3092\u9664\u304f\u51e6\u7406\u306f\u306a\u3044\u3002\u540c\u3058\u5358\u8a9e\u304c\u518d\u3073\u51fa\u308b\u3053\u3068\u304c\u3042\u308b\u3002</p>"},{"location":"howtous/high_and_low/","title":"How to play high and low","text":"<p>\u76ee\u7684</p> <p>\u300c\u5834\u306e\u30ab\u30fc\u30c9\u300d\u3068\u3001\u4f0f\u305b\u3089\u308c\u305f\u6b21\u306e\u30ab\u30fc\u30c9\u306e\u6570\u5b57\u3092\u6bd4\u3079\u3001high / draw / low \u306e\u3069\u308c\u304c\u7b54\u3048\u304b\u3092\u5f53\u3066\u308b\u3002</p>"},{"location":"howtous/high_and_low/#_1","title":"\u904a\u3073\u65b9","text":"<ol> <li>\u753b\u9762\u306b\u5834\u306e\u30ab\u30fc\u30c9(\u30b9\u30fc\u30c8\u3068\u6570\u5b57)\u304c\u8868\u793a\u3055\u308c\u308b\u3002\u6b21\u306e\u30ab\u30fc\u30c9\u306f\u4f0f\u305b\u3089\u308c\u3066\u3044\u308b\u3002</li> <li>\u6b21\u306e\u30ab\u30fc\u30c9\u306e\u6570\u5b57\u304c\u5834\u306e\u30ab\u30fc\u30c9\u3088\u308a\u5927\u304d\u3044\u3068\u601d\u3048\u3070 high\u3001\u5c0f\u3055\u3044\u3068\u601d\u3048\u3070 low\u3001\u540c\u3058\u3060\u3068\u601d\u3048\u3070 draw \u3092\u62bc\u3059\u3002</li> <li>\u62bc\u3059\u3068\u3001\u6b63\u89e3\u30fb\u4e0d\u6b63\u89e3\u3068\u3001\u7b54\u3048\u306e\u30ab\u30fc\u30c9\u30fb\u7b54\u3048(high / low / draw)\u304c\u8868\u793a\u3055\u308c\u308b\u3002</li> <li>\u7b54\u3048\u306e\u30ab\u30fc\u30c9\u304c\u65b0\u3057\u3044\u5834\u306e\u30ab\u30fc\u30c9\u306b\u306a\u308a\u30011\u3064\u524d\u306e\u5834\u306e\u30ab\u30fc\u30c9\u304c\u5de6\u306b\u8868\u793a\u3055\u308c\u308b\u3002\u7d9a\u3051\u3066\u6b21\u306e\u4e88\u60f3\u3092\u3059\u308b\u3002</li> </ol>"},{"location":"howtous/high_and_low/#_2","title":"\u7b54\u3048\u306e\u6c7a\u307e\u308a\u65b9","text":"\u6761\u4ef6 \u7b54\u3048 \u6b21\u306e\u30ab\u30fc\u30c9\u306e\u6570\u5b57 &gt; \u5834\u306e\u30ab\u30fc\u30c9\u306e\u6570\u5b57 high \u6b21\u306e\u30ab\u30fc\u30c9\u306e\u6570\u5b57 &lt; \u5834\u306e\u30ab\u30fc\u30c9\u306e\u6570\u5b57 low \u540c\u3058 draw <p>\u30b9\u30fc\u30c8\u306f\u95a2\u4fc2\u306a\u3044</p> <p>\u6bd4\u3079\u308b\u306e\u306f\u6570\u5b57(1\u301c13)\u3060\u3051\u3067\u3001\u30b9\u30fc\u30c8\u306f\u7b54\u3048\u306b\u5f71\u97ff\u3057\u306a\u3044\u3002</p>"},{"location":"howtous/high_and_low/#_3","title":"\u5f97\u70b9","text":"\u7d50\u679c \u5f97\u70b9 \u6b63\u89e3\u6570 \u554f\u984c\u6570 high / low \u6b63\u89e3 +1 +1 +1 draw \u6b63\u89e3 (\u73fe\u5728\u306e\u5f97\u70b9 + 1) \u00d7 2 +1 +1 \u4e0d\u6b63\u89e3 \u5909\u5316\u306a\u3057 \u5909\u5316\u306a\u3057 +1 <p>\u753b\u9762\u306e\u8868\u793a</p> <p>\u753b\u9762\u306b\u306f \u5f97\u70b9\u30fb\u554f\u984c\u6570\u30fb\u6b63\u89e3\u6570\u30fb\u8aa4\u7b54\u6570 \u304c\u8868\u793a\u3055\u308c\u308b\u3002\u8aa4\u7b54\u6570\u306f\u300c\u554f\u984c\u6570 \u2212 \u6b63\u89e3\u6570\u300d\u3002</p>"},{"location":"howtous/high_and_low/#_4","title":"\u7d42\u4e86","text":"<p>\u5168\u30ab\u30fc\u30c9\u304c\u3081\u304f\u3089\u308c\u305f\u3089\u7d42\u4e86</p> <p>\u30ab\u30fc\u30c9\u306f52\u679a(4\u30b9\u30fc\u30c8 \u00d7 13)\u3002\u7d42\u4e86\u3059\u308b\u3068\u3001\u7dcf\u5f97\u70b9\u3068\u6b63\u7b54\u7387(\u6b63\u89e3\u6570 \u00f7 \u554f\u984c\u6570\u3001\u5c0f\u6570\u7b2c1\u4f4d\u307e\u3067\u30fb\u4ee5\u4e0b\u5207\u308a\u6368\u3066)\u304c\u8868\u793a\u3055\u308c\u308b\u3002 <code>\u3082\u3046\u4e00\u56de\u3084\u308b\u306a\u3089\u3053\u3053\u3092\u30af\u30ea\u30c3\u30af</code> \u30dc\u30bf\u30f3\u3067\u3001\u6700\u521d\u304b\u3089\u3084\u308a\u76f4\u305b\u308b\u3002</p>"},{"location":"howtous/kanji_reversi/","title":"How to play kanji reversi","text":"<p>\u76ee\u7684</p> <p>\u30ea\u30d0\u30fc\u30b7\u3067\u52dd\u3064\u3002\u307e\u305f\u306f\u3001\u76e4\u9762\u306b\u96a0\u308c\u305f\u6f22\u5b57\u3092\u5f53\u3066\u308b\u3002\u3069\u3061\u3089\u304b\u5148\u306b\u9054\u6210\u3059\u308c\u3070\u52dd\u3061\u3002</p>"},{"location":"howtous/kanji_reversi/#_1","title":"\u59cb\u3081\u308b\u524d\u306b","text":"<ol> <li>\u81ea\u5206\u306e\u8272(\u9ed2=\u5148\u624b / \u767d=\u5f8c\u624b)\u3092\u9078\u3076\u3002</li> <li>\u6575\u306e\u5f37\u3055\u3092\u9078\u3076(\u6fc0\u3088\u308f / \u3088\u308f / \u3075\u3064\u30fc / \u3064\u3088 / \u3052\u304d\u3064\u3088\u3002\u521d\u671f\u5024\u306f \u3075\u3064\u30fc)\u3002</li> <li><code>\u5bfe\u6226\u958b\u59cb</code> \u3092\u62bc\u3059\u3002\u6f22\u5b57\u306f\u3001\u6bce\u56de\u30ea\u30b9\u30c8\u304b\u3089\u30e9\u30f3\u30c0\u30e0\u306b1\u6587\u5b57\u9078\u3070\u308c\u308b\u3002</li> </ol>"},{"location":"howtous/kanji_reversi/#_2","title":"\u904a\u3073\u65b9","text":"<ol> <li>\u81ea\u5206\u306e\u756a\u306b\u306a\u308b\u3068\u3001\u7f6e\u3051\u308b\u30de\u30b9\u306b\u9ec4\u8272\u3044\u70b9\u304c\u51fa\u308b\u3002\u70b9\u306e\u3042\u308b\u30de\u30b9\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u77f3\u3092\u7f6e\u304f\u3002</li> <li>\u631f\u3093\u3060\u76f8\u624b\u306e\u77f3\u306f\u88cf\u8fd4\u308a\u3001\u81ea\u5206\u306e\u77f3\u306b\u306a\u308b\u3002</li> <li>\u76e4\u9762\u306e\u81ea\u5206\u306e\u77f3\u304c\u3042\u308b\u30de\u30b9\u306b\u306f\u3001\u5f8c\u308d\u306b\u96a0\u308c\u305f\u6f22\u5b57\u306e\u4e00\u90e8\u304c\u898b\u3048\u308b\u3002</li> <li>\u4e00\u90e8\u3092\u624b\u304c\u304b\u308a\u306b\u6f22\u5b57\u3092\u63a8\u7406\u3057\u3001\u4e88\u60f3\u6b04\u306b\u5165\u529b\u3057\u3066 <code>\u4e88\u60f3\u3059\u308b</code> \u3092\u62bc\u3059\u3002</li> </ol> <p>\u6f22\u5b57\u306e\u898b\u3048\u65b9</p> <p>\u6f22\u5b57\u306f\u76e4\u9762\u5168\u4f53(8\u00d78)\u306b\u5e83\u3052\u305f1\u679a\u306e\u7d75\u306b\u306a\u3063\u3066\u3044\u3066\u3001\u5404\u30de\u30b9\u306f\u305d\u306e1/64\u3092\u62c5\u5f53\u3059\u308b\u3002 \u81ea\u5206\u306e\u77f3\u304c\u3042\u308b\u30de\u30b9\u3060\u3051\u3001\u305d\u306e\u30de\u30b9\u306e\u9818\u57df(\u77f3\u306e\u5916\u306e\u56db\u9685\u3092\u542b\u3080)\u304c\u8868\u793a\u3055\u308c\u308b\u3002 \u77f3\u3092\u88cf\u8fd4\u3055\u308c\u308b\u3068\u3001\u305d\u306e\u30de\u30b9\u306e\u6f22\u5b57\u306f\u898b\u3048\u306a\u304f\u306a\u308b\u3002\u53d6\u308a\u8fd4\u305b\u3070\u3001\u307e\u305f\u898b\u3048\u308b\u3002 \u76f8\u624b\u306e\u77f3\u306e\u30de\u30b9\u3068\u7a7a\u304d\u30de\u30b9\u306b\u306f\u3001\u6f22\u5b57\u306f\u51fa\u306a\u3044\u3002</p>"},{"location":"howtous/kanji_reversi/#_3","title":"\u6f22\u5b57\u306e\u4e88\u60f3","text":"<ul> <li>\u4e88\u60f3\u306f\u81ea\u5206\u306e\u756a\u306e\u3068\u304d\u3060\u3051\u3067\u304d\u308b\u3002\u4e88\u60f3\u3057\u3066\u3082\u624b\u756a\u306f\u6d88\u8cbb\u3057\u306a\u3044\u3002</li> <li>\u5165\u529b\u306f\u6f22\u5b571\u6587\u5b57\u3002\u7a7a\u6b04\u30842\u6587\u5b57\u4ee5\u4e0a\u306f\u4e88\u60f3\u3068\u3057\u3066\u6570\u3048\u305a\u3001\u300c\u6f22\u5b57\u30921\u6587\u5b57\u3067\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044\u300d\u3068\u8868\u793a\u3055\u308c\u308b\u3002</li> <li>\u5916\u308c\u3066\u3082\u4f55\u5ea6\u3067\u3082\u7d9a\u3051\u3089\u308c\u308b\u3002</li> <li>\u5f53\u305f\u308c\u3070\u305d\u306e\u5834\u3067\u52dd\u3061\u3002</li> </ul>"},{"location":"howtous/kanji_reversi/#_4","title":"\u52dd\u6557","text":"\u6761\u4ef6 \u7d50\u679c \u6f22\u5b57\u3092\u5f53\u3066\u305f \u3042\u306a\u305f\u306e\u52dd\u3061 \u76e4\u9762\u304c\u57cb\u307e\u308b\u3001\u307e\u305f\u306f\u4e21\u8005\u3068\u3082\u7f6e\u3051\u306a\u304f\u306a\u3063\u305f\u3068\u304d\u3001\u77f3\u306e\u6570\u304c\u591a\u3044 \u305d\u306e\u77f3\u306e\u8272\u306e\u52dd\u3061 \u77f3\u306e\u6570\u304c\u540c\u3058 \u5f15\u304d\u5206\u3051 <p>\u30d1\u30b9</p> <p>\u7f6e\u3051\u308b\u5834\u6240\u304c\u306a\u3044\u3068\u304d\u306f\u81ea\u52d5\u3067\u30d1\u30b9\u306b\u306a\u308a\u3001\u76f8\u624b\u306e\u756a\u306b\u79fb\u308b\u3002\u300c\u3042\u306a\u305f\u306f\u30d1\u30b9\u3057\u307e\u3057\u305f\u300d\u300c\u76f8\u624b\u306f\u30d1\u30b9\u3057\u307e\u3057\u305f\u300d\u3068\u8868\u793a\u3055\u308c\u308b\u3002</p> <p>\u7d42\u4e86\u5f8c\u306e\u8868\u793a</p> <p>\u52dd\u6557\u306b\u95a2\u308f\u3089\u305a\u3001\u7d42\u4e86\u3059\u308b\u3068\u7b54\u3048\u306e\u6f22\u5b57\u304c\u8868\u793a\u3055\u308c\u308b\u3002</p>"},{"location":"howtous/kanji_reversi/#_5","title":"\u6575\u306e\u52d5\u304d","text":"<p>\u6575\u306f\u4e00\u5b9a\u6642\u9593\u3092\u7f6e\u3044\u3066\u304b\u3089\u6253\u3064\u3002\u5f37\u3055\u304c\u4e0a\u304c\u308b\u307b\u3069\u5f85\u3061\u6642\u9593\u304c\u9577\u3044\u3002\u6575\u304c\u8003\u3048\u3066\u3044\u308b\u9593\u306f\u76e4\u9762\u3092\u62bc\u305b\u306a\u3044\u304c\u3001<code>\u6700\u521d\u304b\u3089\u904a\u3076</code> \u306f\u62bc\u305b\u308b\u3002</p> <p>\u30ea\u30bb\u30c3\u30c8</p> <p><code>\u6700\u521d\u304b\u3089\u904a\u3076</code> \u3092\u62bc\u3059\u3068\u3001\u5bfe\u5c40\u306f\u7834\u68c4\u3055\u308c\u3066\u8a2d\u5b9a\u753b\u9762\u306b\u623b\u308b\u3002</p>"}]}