{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"app-practice","text":"<p>Streamlit \u306e\u7df4\u7fd2\u7528\u30de\u30eb\u30c1\u30da\u30fc\u30b8\u30a2\u30d7\u30ea\u3002</p> <p>\u30a2\u30d7\u30ea\u3092\u958b\u304f</p>"},{"location":"#_1","title":"\u904a\u3073\u65b9","text":"<ul> <li> <p> hangman</p> <p>\u4f0f\u305b\u3089\u308c\u305f\u82f1\u5358\u8a9e\u30921\u6587\u5b57\u305a\u3064\u5f53\u3066\u308b\u3002\u30df\u30b9\u306f8\u56de\u307e\u3067\u3002</p> <p> How to play hangman</p> </li> <li> <p> high and low</p> <p>\u5834\u306e\u30ab\u30fc\u30c9\u3068\u6b21\u306e\u30ab\u30fc\u30c9\u306e\u5927\u5c0f\u3092\u4e88\u60f3\u3059\u308b\u3002</p> <p> How to play high and low</p> </li> </ul>"},{"location":"about/","title":"Two games are here","text":""},{"location":"howtous/hang_man/","title":"How to play hangman","text":""},{"location":"howtous/hang_man/#_1","title":"\u76ee\u7684","text":"<p>\u4f0f\u305b\u3089\u308c\u305f\u82f1\u5358\u8a9e\u3092\u30011\u6587\u5b57\u305a\u3064\u5f53\u3066\u3066\u5b8c\u6210\u3055\u305b\u308b\u3002</p>"},{"location":"howtous/hang_man/#_2","title":"\u904a\u3073\u65b9","text":"<ol> <li>\u753b\u9762\u306b\u3001\u5358\u8a9e\u306e\u6587\u5b57\u6570\u5206\u306e\u4e0b\u7dda(<code>_</code>)\u3068\u7d5e\u9996\u53f0\u306e\u7d75\u304c\u8868\u793a\u3055\u308c\u308b\u3002\u5358\u8a9e\u306f\u5358\u8a9e\u30ea\u30b9\u30c8\u304b\u3089\u30e9\u30f3\u30c0\u30e0\u306b\u9078\u3070\u308c\u308b\u3002</li> <li>A\u301cZ \u306e\u30dc\u30bf\u30f3\u304b\u3089\u3001\u5358\u8a9e\u306b\u542b\u307e\u308c\u308b\u3068\u601d\u3046\u6587\u5b57\u3092\u9078\u3076\u3002</li> <li>\u542b\u307e\u308c\u3066\u3044\u308c\u3070\u3001\u305d\u306e\u6587\u5b57\u304c\u5165\u308b\u4f4d\u7f6e\u3059\u3079\u3066\u306b\u540c\u6642\u306b\u8868\u793a\u3055\u308c\u308b\u3002</li> <li>\u542b\u307e\u308c\u3066\u3044\u306a\u3051\u308c\u3070\u30df\u30b9\u306b\u306a\u308a\u3001\u7d75\u304c1\u6bb5\u968e\u9032\u3080\u3002</li> <li>\u3059\u3079\u3066\u306e\u6587\u5b57\u3092\u5f53\u3066\u308c\u3070\u52dd\u3061(<code>CLEAR</code>)\u3002</li> </ol>"},{"location":"howtous/hang_man/#_3","title":"\u9078\u3093\u3060\u6587\u5b57","text":"<ul> <li>\u4e00\u5ea6\u9078\u3093\u3060\u6587\u5b57\u306e\u30dc\u30bf\u30f3\u306f \u274c \u8868\u793a\u306b\u306a\u308a\u3001\u62bc\u305b\u306a\u304f\u306a\u308b\u3002</li> </ul>"},{"location":"howtous/hang_man/#_4","title":"\u30df\u30b9\u3068\u30b2\u30fc\u30e0\u30aa\u30fc\u30d0\u30fc","text":"<ul> <li>\u30df\u30b9\u306f8\u56de\u307e\u3067\u30028\u56de\u76ee\u306e\u30df\u30b9\u3067 <code>GAME OVER</code> \u306b\u306a\u308b\u3002</li> </ul>"},{"location":"howtous/hang_man/#_5","title":"\u7d50\u679c\u306e\u8868\u793a","text":"<ul> <li><code>CLEAR</code> \u307e\u305f\u306f <code>GAME OVER</code> \u306e\u753b\u9762\u306b\u3001\u7b54\u3048\u306e\u5358\u8a9e\u3068\u65e5\u672c\u8a9e\u306e\u610f\u5473\u304c\u8868\u793a\u3055\u308c\u308b\u3002</li> <li><code>CONTINUE?</code> \u30dc\u30bf\u30f3\u3092\u62bc\u3059\u3068\u3001\u65b0\u3057\u3044\u5358\u8a9e\u3067\u6700\u521d\u304b\u3089\u3084\u308a\u76f4\u305b\u308b\u3002\u30df\u30b9\u306e\u56de\u6570\u3068\u9078\u629e\u6e08\u307f\u306e\u6587\u5b57\u306f\u30ea\u30bb\u30c3\u30c8\u3055\u308c\u308b\u3002</li> <li>\u5358\u8a9e\u306f\u30e9\u30f3\u30c0\u30e0\u306b\u9078\u3070\u308c\u3001\u51fa\u984c\u6e08\u307f\u306e\u5358\u8a9e\u3092\u9664\u304f\u51e6\u7406\u306f\u306a\u3044\u3002\u540c\u3058\u5358\u8a9e\u304c\u518d\u3073\u51fa\u308b\u3053\u3068\u304c\u3042\u308b\u3002</li> </ul>"},{"location":"howtous/high_and_low/","title":"How to play high and low","text":""},{"location":"howtous/high_and_low/#_1","title":"\u76ee\u7684","text":"<p>\u300c\u5834\u306e\u30ab\u30fc\u30c9\u300d\u3068\u3001\u4f0f\u305b\u3089\u308c\u305f\u6b21\u306e\u30ab\u30fc\u30c9\u306e\u6570\u5b57\u3092\u6bd4\u3079\u3001<code>high</code> / <code>draw</code> / <code>low</code> \u306e\u3069\u308c\u304c\u7b54\u3048\u304b\u3092\u5f53\u3066\u308b\u3002</p>"},{"location":"howtous/high_and_low/#_2","title":"\u904a\u3073\u65b9","text":"<ol> <li>\u753b\u9762\u306b\u5834\u306e\u30ab\u30fc\u30c9(\u30b9\u30fc\u30c8\u3068\u6570\u5b57)\u304c\u8868\u793a\u3055\u308c\u308b\u3002\u6b21\u306e\u30ab\u30fc\u30c9\u306f\u4f0f\u305b\u3089\u308c\u3066\u3044\u308b\u3002</li> <li>\u6b21\u306e\u30ab\u30fc\u30c9\u306e\u6570\u5b57\u304c\u5834\u306e\u30ab\u30fc\u30c9\u3088\u308a\u5927\u304d\u3044\u3068\u601d\u3048\u3070 <code>high</code>\u3001\u5c0f\u3055\u3044\u3068\u601d\u3048\u3070 <code>low</code>\u3001\u540c\u3058\u3060\u3068\u601d\u3048\u3070 <code>draw</code> \u3092\u62bc\u3059\u3002</li> <li>\u62bc\u3059\u3068\u3001\u6b63\u89e3\u30fb\u4e0d\u6b63\u89e3\u3068\u3001\u7b54\u3048\u306e\u30ab\u30fc\u30c9\u30fb\u7b54\u3048(high / low / draw)\u304c\u8868\u793a\u3055\u308c\u308b\u3002</li> <li>\u7b54\u3048\u306e\u30ab\u30fc\u30c9\u304c\u65b0\u3057\u3044\u5834\u306e\u30ab\u30fc\u30c9\u306b\u306a\u308a\u30011\u3064\u524d\u306e\u5834\u306e\u30ab\u30fc\u30c9\u304c\u5de6\u306b\u8868\u793a\u3055\u308c\u308b\u3002\u7d9a\u3051\u3066\u6b21\u306e\u4e88\u60f3\u3092\u3059\u308b\u3002</li> </ol>"},{"location":"howtous/high_and_low/#_3","title":"\u7b54\u3048\u306e\u6c7a\u307e\u308a\u65b9","text":"\u6761\u4ef6 \u7b54\u3048 \u6b21\u306e\u30ab\u30fc\u30c9\u306e\u6570\u5b57 &gt; \u5834\u306e\u30ab\u30fc\u30c9\u306e\u6570\u5b57 high \u6b21\u306e\u30ab\u30fc\u30c9\u306e\u6570\u5b57 &lt; \u5834\u306e\u30ab\u30fc\u30c9\u306e\u6570\u5b57 low \u540c\u3058 draw <ul> <li>\u6bd4\u3079\u308b\u306e\u306f\u6570\u5b57(1\u301c13)\u3060\u3051\u3067\u3001\u30b9\u30fc\u30c8\u306f\u7b54\u3048\u306b\u5f71\u97ff\u3057\u306a\u3044\u3002</li> </ul>"},{"location":"howtous/high_and_low/#_4","title":"\u5f97\u70b9","text":"\u7d50\u679c \u5f97\u70b9 \u6b63\u89e3\u6570 \u554f\u984c\u6570 high / low \u6b63\u89e3 +1 +1 +1 draw \u6b63\u89e3 (\u73fe\u5728\u306e\u5f97\u70b9 + 1) \u00d7 2 +1 +1 \u4e0d\u6b63\u89e3 \u5909\u5316\u306a\u3057 \u5909\u5316\u306a\u3057 +1 <ul> <li>\u753b\u9762\u306b\u306f \u5f97\u70b9\u30fb\u554f\u984c\u6570\u30fb\u6b63\u89e3\u6570\u30fb\u8aa4\u7b54\u6570 \u304c\u8868\u793a\u3055\u308c\u308b\u3002</li> <li>\u8aa4\u7b54\u6570\u306f\u300c\u554f\u984c\u6570 \u2212 \u6b63\u89e3\u6570\u300d\u3002</li> </ul>"},{"location":"howtous/high_and_low/#_5","title":"\u7d42\u4e86","text":"<ul> <li>\u30ab\u30fc\u30c9\u306f52\u679a(4\u30b9\u30fc\u30c8 \u00d7 13)\u3002\u5168\u30ab\u30fc\u30c9\u304c\u3081\u304f\u3089\u308c\u308b\u3068\u7d42\u4e86\u3059\u308b\u3002\u7dcf\u5f97\u70b9\u3068\u6b63\u7b54\u7387(\u6b63\u89e3\u6570 \u00f7 \u554f\u984c\u6570\u3001\u5c0f\u6570\u7b2c1\u4f4d\u307e\u3067\u30fb\u4ee5\u4e0b\u5207\u308a\u6368\u3066)\u304c\u8868\u793a\u3055\u308c\u308b\u3002</li> <li>\u7d42\u4e86\u753b\u9762\u306e <code>\u3082\u3046\u4e00\u56de\u3084\u308b\u306a\u3089\u3053\u3053\u3092\u30af\u30ea\u30c3\u30af</code> \u30dc\u30bf\u30f3\u3067\u3001\u6700\u521d\u304b\u3089\u3084\u308a\u76f4\u305b\u308b\u3002</li> </ul>"}]}